
* {
  box-sizing: border-box;
}

:root {
  color-scheme: dark;
  --bg: #101326;
  --panel: #1b2038;
  --purple: #8055ff;
  --cyan: #35d9e8;
  --text: #f8f9ff;
  --muted: #b8bfd8;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, Arial, sans-serif;
  text-align: center;
}

header {
  padding: 28px 15px;
  background: linear-gradient(135deg, #642eff, #00a9c7);
}

.logo {
  font-size: clamp(26px, 7vw, 38px);
  font-weight: 900;
  letter-spacing: 1px;
}

header p {
  margin-bottom: 0;
}

main {
  max-width: 850px;
  margin: auto;
  padding: 20px 14px 35px;
}

h1, h2 {
  margin: 12px 0;
}

.muted {
  color: var(--muted);
}

.game-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 22px;
}

.game-card {
  min-height: 120px;
  border: 1px solid #353b5c;
  border-radius: 16px;
  background: var(--panel);
  color: var(--text);
  padding: 15px 8px;
  cursor: pointer;
  font-size: 16px;
  font-weight: 700;
  transition: transform .15s, border-color .15s;
}

.game-card:active {
  transform: scale(.96);
}

.game-card:hover {
  border-color: var(--cyan);
}

.emoji {
  display: block;
  font-size: 35px;
  margin-bottom: 8px;
}

button {
  border: 0;
  border-radius: 11px;
  padding: 12px 16px;
  color: white;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  touch-action: manipulation;
}

.primary {
  background: var(--purple);
  margin: 12px 0;
}

.secondary {
  background: #343b59;
}

button:active {
  opacity: .8;
}

.arena {
  margin: 18px auto;
  width: 100%;
  max-width: 440px;
}

.arena:empty {
  display: none;
}

.arena button {
  margin: 4px;
}

.arena input {
  width: min(100%, 230px);
  padding: 13px;
  border-radius: 10px;
  border: 1px solid #68708f;
  background: #101326;
  color: white;
  font-size: 18px;
}

.arena-grid {
  display: grid;
  gap: 7px;
  margin: 12px auto;
  max-width: 340px;
}

.tile {
  min-width: 0;
  aspect-ratio: 1;
  padding: 2px;
  background: #303753;
  font-size: clamp(18px, 6vw, 29px);
}

.board2048 .tile {
  color: #fff;
  background: #333b56;
}

.controls {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin: 12px auto;
}

.controls button {
  min-width: 54px;
  min-height: 46px;
  background: #303753;
}

canvas {
  display: block;
  width: 100%;
  max-width: 360px;
  height: auto;
  margin: 12px auto;
  background: #090d1a;
  border: 1px solid #414966;
  border-radius: 12px;
  touch-action: none;
}

#status {
  color: var(--cyan);
  font-weight: 700;
  min-height: 25px;
}

[hidden] {
  display: none !important;
}

footer {
  padding: 22px 10px;
  color: var(--muted);
  font-size: 13px;
}

@media (min-width: 600px) {
  .game-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 360px) {
  main {
    padding: 14px 9px;
  }

  .game-card {
    font-size: 14px;
  }
}
